{
  "name": "@aws-lambda-powertools/feature-flags",
  "version": "2.36.0",
  "description": "The feature flags package for the Powertools for AWS Lambda (TypeScript) library.",
  "author": {
    "name": "Amazon Web Services",
    "url": "https://aws.amazon.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest --run tests/unit",
    "test:unit": "vitest --run tests/unit",
    "test:unit:coverage": "vitest --run tests/unit --coverage.enabled --coverage.thresholds.100 --coverage.include='src/**'",
    "test:unit:types": "vitest --run tests/types --typecheck",
    "test:unit:watch": "vitest tests/unit",
    "test:e2e:nodejs22x": "echo 'Not Implemented'",
    "test:e2e:nodejs24x": "echo 'Not Implemented'",
    "test:e2e": "echo 'Not Implemented'",
    "build:cjs": "tsc --build tsconfig.cjs.json && echo '{ \"type\": \"commonjs\" }' > lib/cjs/package.json",
    "build:esm": "tsc --build tsconfig.json && echo '{ \"type\": \"module\" }' > lib/esm/package.json",
    "build:tests": "tsc --noEmit -p tests/tsconfig.json",
    "build": "npm run build:esm & npm run build:cjs",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "prepack": "node ../../.github/scripts/release_patch_package_json.js ."
  },
  "homepage": "https://github.com/aws-powertools/powertools-lambda-typescript/tree/main/packages/feature-flags#readme",
  "license": "MIT-0",
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/cjs/index.d.ts",
        "default": "./lib/cjs/index.js"
      },
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      }
    },
    "./appconfig": {
      "require": {
        "types": "./lib/cjs/appconfig/index.d.ts",
        "default": "./lib/cjs/appconfig/index.js"
      },
      "import": {
        "types": "./lib/esm/appconfig/index.d.ts",
        "default": "./lib/esm/appconfig/index.js"
      }
    },
    "./appconfig-agent": {
      "require": {
        "types": "./lib/cjs/appconfig-agent/index.d.ts",
        "default": "./lib/cjs/appconfig-agent/index.js"
      },
      "import": {
        "types": "./lib/esm/appconfig-agent/index.d.ts",
        "default": "./lib/esm/appconfig-agent/index.js"
      }
    },
    "./envelope": {
      "require": {
        "types": "./lib/cjs/envelope/index.d.ts",
        "default": "./lib/cjs/envelope/index.js"
      },
      "import": {
        "types": "./lib/esm/envelope/index.d.ts",
        "default": "./lib/esm/envelope/index.js"
      }
    },
    "./errors": {
      "require": {
        "types": "./lib/cjs/errors.d.ts",
        "default": "./lib/cjs/errors.js"
      },
      "import": {
        "types": "./lib/esm/errors.d.ts",
        "default": "./lib/esm/errors.js"
      }
    },
    "./types": {
      "require": {
        "types": "./lib/cjs/types/index.d.ts",
        "default": "./lib/cjs/types/index.js"
      },
      "import": {
        "types": "./lib/esm/types/index.d.ts",
        "default": "./lib/esm/types/index.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "index": [
        "lib/cjs/index.d.ts",
        "lib/esm/index.d.ts"
      ],
      "appconfig": [
        "lib/cjs/appconfig/index.d.ts",
        "lib/esm/appconfig/index.d.ts"
      ],
      "appconfig-agent": [
        "lib/cjs/appconfig-agent/index.d.ts",
        "lib/esm/appconfig-agent/index.d.ts"
      ],
      "envelope": [
        "lib/cjs/envelope/index.d.ts",
        "lib/esm/envelope/index.d.ts"
      ],
      "errors": [
        "lib/cjs/errors.d.ts",
        "lib/esm/errors.d.ts"
      ],
      "types": [
        "lib/cjs/types/index.d.ts",
        "lib/esm/types/index.d.ts"
      ]
    }
  },
  "types": "./lib/cjs/index.d.ts",
  "main": "./lib/cjs/index.js",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aws-powertools/powertools-lambda-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/aws-powertools/powertools-lambda-typescript/issues"
  },
  "keywords": [
    "aws",
    "lambda",
    "powertools",
    "feature-flags",
    "appconfig",
    "serverless",
    "typescript",
    "nodejs"
  ],
  "dependencies": {
    "@aws-lambda-powertools/commons": "2.36.0",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@aws-lambda-powertools/testing-utils": "file:../testing"
  },
  "peerDependencies": {
    "@aws-lambda-powertools/parameters": "2.36.0",
    "@aws-lambda-powertools/jmespath": "2.36.0"
  },
  "peerDependenciesMeta": {
    "@aws-lambda-powertools/parameters": {
      "optional": true
    },
    "@aws-lambda-powertools/jmespath": {
      "optional": true
    }
  }
}
