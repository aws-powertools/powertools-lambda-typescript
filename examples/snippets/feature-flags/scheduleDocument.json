{
  "happy_hour": {
    "default": false,
    "rules": {
      "evening_in_rome": {
        "when_match": true,
        "conditions": [
          {
            "action": "SCHEDULE_BETWEEN_TIME_RANGE",
            "key": "CURRENT_TIME",
            "value": {
              "START": "17:00",
              "END": "19:00",
              "TIMEZONE": "Europe/Rome"
            }
          }
        ]
      }
    }
  },
  "holiday_sale": {
    "default": false,
    "rules": {
      "december_campaign": {
        "when_match": true,
        "conditions": [
          {
            "action": "SCHEDULE_BETWEEN_DATETIME_RANGE",
            "key": "CURRENT_DATETIME",
            "value": {
              "START": "2026-12-25T12:00:00",
              "END": "2026-12-31T23:59:59",
              "TIMEZONE": "America/New_York"
            }
          }
        ]
      }
    }
  },
  "weekend_discount": {
    "default": false,
    "rules": {
      "weekend_in_new_york": {
        "when_match": true,
        "conditions": [
          {
            "action": "SCHEDULE_BETWEEN_DAYS_OF_WEEK",
            "key": "CURRENT_DAY_OF_WEEK",
            "value": {
              "DAYS": ["SATURDAY", "SUNDAY"],
              "TIMEZONE": "America/New_York"
            }
          }
        ]
      }
    }
  }
}
